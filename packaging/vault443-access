#!/bin/sh
set -eu
if [ "$(id -u)" -ne 0 ] || [ "$#" -ne 1 ]; then
  echo 'Usage: sudo vault443-access USER' >&2
  exit 1
fi
case "$1" in ''|-*|*[!a-zA-Z0-9_.-]*) echo 'Invalid local username' >&2; exit 1;; esac
id "$1" >/dev/null
usermod -a -G vault443 "$1"
echo "Access granted to $1. Open Vault 443 from an active local desktop session."
